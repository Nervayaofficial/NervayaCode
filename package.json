{
  "name": "nervaya",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node api.js && next dev --turbopack",
    "build": "node api.js && next build --webpack",
    "start": "node api.js && next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix .",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report e2e/.artifacts/html-report",
    "test:e2e:results": "python3 scripts/update-test-results.py"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@jitsi/react-sdk": "^1.4.4",
    "@next/third-parties": "^16.2.6",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@types/pdfkit": "^0.17.6",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.13.2",
    "cloudinary": "^2.8.0",
    "framer-motion": "^12.25.0",
    "googleapis": "^171.4.0",
    "jose": "^6.1.3",
    "lottie-react": "^2.4.1",
    "mongoose": "^9.1.2",
    "next": "16.2.6",
    "nodemailer": "^8.0.1",
    "pdfkit": "^0.20.1",
    "razorpay": "^2.9.6",
    "react": "19.2.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.3",
    "react-player": "^3.4.0",
    "react-quill-new": "^3.7.0",
    "sonner": "^2.0.7",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "postcss": "^8.5.15"
  }
}
